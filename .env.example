# Database URL for PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tech_inject?schema=public"

# JWT Secret for access token generation and verification
JWT_SECRET="tech-inject-super-secret-jwt-key-for-development-do-not-use-in-production-32char"

# Secret used for hashing and signing license keys
LICENSE_SECRET="tech-inject-super-secret-license-key-for-development-hash-secret-32char"

# API URL for frontend apps and CLI to reach the API server
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# Default seed credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# Node environment
NODE_ENV="development"
PORT=3001
