{
  "name": "tech-inject-design-library",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev:catalogue": "npm run dev --workspace=@tech-inject/catalogue",
    "dev:admin": "npm run dev --workspace=@tech-inject/admin",
    "dev:api": "npm run dev --workspace=@tech-inject/api",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "prisma": "^5.21.1"
  }
}
